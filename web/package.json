{
  "name": "mtmms-desktop",
  "productName": "MTMMS Desktop",
  "version": "1.0.0",
  "description": "Mobile Tower Maintenance & Management System - Desktop Portal",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:start": "cross-env ELECTRON_DEV=true electron .",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:5174 && npm run electron:start\"",
    "electron:build": "vite build && electron-builder --win --x64",
    "electron:pack": "vite build && electron-builder --dir",
    "pack:win": "vite build && electron-packager . \"MTMMS Desktop\" --platform=win32 --arch=x64 --out=dist-desktop --overwrite --prune=true"
  },
  "build": {
    "appId": "com.mtmms.desktop",
    "productName": "MTMMS Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "axios": "^1.19.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-packager": "^17.1.2",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "vite": "^8.2.2",
    "wait-on": "^9.5.1"
  }
}
